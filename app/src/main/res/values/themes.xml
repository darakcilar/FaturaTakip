<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FaturaTakipUygulaması" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="android:windowBackground">@color/app_background</item>

        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:datePickerDialogTheme">@style/CustomDatePickerTheme</item>
    </style>

    <style name="CustomDatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/purple_200</item>

        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerButtonStyle</item>

        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="DatePickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/purple_700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AnalyticsLabel" parent="Widget.AppCompat.TextView">
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="AnalyticsValue" parent="Widget.AppCompat.TextView">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="AnalyticsValue.Paid">
        <item name="android:textColor">@color/paid_green_text</item>
    </style>

    <style name="AnalyticsValue.Unpaid">
        <item name="android:textColor">@color/overdue_red_text</item>
    </style>

    <style name="Widget.App.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/purple_200</item>
    </style>

</resources>