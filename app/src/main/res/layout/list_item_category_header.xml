<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/category_main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/categoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                tools:text="Elektrik Faturaları" />

            <TextView
                android:id="@+id/invoiceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_category_header"
                android:backgroundTint="?attr/colorPrimary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                tools:text="3" />

            <ImageView
                android:id="@+id/expandIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Genişlet/Daralt"
                android:src="@drawable/ic_arrow_drop_down" />
        </LinearLayout>

        <!-- YENİ EKLENDİ: Kategori işlem butonları -->
        <LinearLayout
            android:id="@+id/category_actions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kategori İşlemleri"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ImageButton
                android:id="@+id/categoryPdfButton"
                style="@style/Widget.App.ImageButton"
                android:contentDescription="Kategori Raporu (PDF)"
                android:src="@drawable/ic_file_text" />

            <ImageButton
                android:id="@+id/categoryEditButton"
                style="@style/Widget.App.ImageButton"
                android:contentDescription="Kategoriyi Yeniden Adlandır"
                android:src="@drawable/ic_edit" />

            <ImageButton
                android:id="@+id/categoryDeleteButton"
                style="@style/Widget.App.ImageButton"
                android:contentDescription="Kategoriyi Sil"
                android:src="@drawable/ic_delete" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

