<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Harcama Analizi"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:layout_marginBottom="16dp"/>

        <com.faturatakip.faturatakip0.ui.views.PieChartView
            android:id="@+id/customPieChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/legendContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:background="#F9F9F9"
            android:padding="12dp"/>

        <TextView
            android:text="Özet Bilgiler"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView android:text="Toplam Fatura:" android:padding="4dp"/>
            <TextView android:id="@+id/totalCount" android:text="0" android:textStyle="bold" android:padding="4dp" android:gravity="end" android:layout_gravity="fill_horizontal"/>

            <TextView android:text="Toplam Ödenen:" android:padding="4dp"/>
            <TextView android:id="@+id/paidAmount" android:text="0.00 TL" android:textColor="#4CAF50" android:textStyle="bold" android:padding="4dp" android:gravity="end" android:layout_gravity="fill_horizontal"/>

            <TextView android:text="Toplam Borç:" android:padding="4dp"/>
            <TextView android:id="@+id/unpaidAmount" android:text="0.00 TL" android:textColor="#F44336" android:textStyle="bold" android:padding="4dp" android:gravity="end" android:layout_gravity="fill_horizontal"/>
        </GridLayout>

        <Button
            android:id="@+id/closeAnalyticsBtn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="Kapat" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>